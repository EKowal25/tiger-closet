<%- include('partials/header') %>
<section class="narrow card">
  <h1>Log in</h1>
  <p class="note">Tiger Closet is only for Princeton students. <strong>Use your @<%= domain %> school email.</strong></p>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>School email
      <input type="email" name="email" value="<%= email %>" placeholder="netid@<%= domain %>" required autocomplete="username" pattern=".+@<%= domain.replace(/\./g, '\\.') %>" title="Use your @<%= domain %> email">
    </label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn big">Log in</button>
  </form>
  <p class="links"><a href="/signup?next=<%= encodeURIComponent(next) %>">Create an account</a> · <a href="/forgot">Forgot password?</a></p>
</section>
<%- include('partials/footer') %>
