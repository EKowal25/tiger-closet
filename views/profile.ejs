<%- include('partials/header') %>
<section class="narrow card">
  <h1><%= welcome ? 'Welcome! Set up your profile' : 'Your profile' %></h1>
  <p class="muted">Logged in as <strong><%= user.email %></strong>. Your contact info is only shared with someone after you accept their request (or they accept yours).</p>
  <form method="post" action="/profile" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Name <input name="name" value="<%= user.name || '' %>" required maxlength="80"></label>
    <div class="row">
      <label>Class year <input name="class_year" value="<%= user.class_year || '' %>" placeholder="2028" maxlength="4"></label>
      <label>Residential college
        <select name="college">
          <option value="">—</option>
          <% colleges.forEach(c => { %><option <%= user.college === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </label>
    </div>
    <label>Phone (optional) <input name="phone" value="<%= user.phone || '' %>" maxlength="30" placeholder="For texting about pickup, or Zelle"></label>
    <label>Venmo username (optional) <input name="venmo" value="<%= user.venmo ? '@' + user.venmo : '' %>" maxlength="40" placeholder="@your-venmo" autocapitalize="none" autocomplete="off">
      <small class="muted">For deposits and rental fees. Only shown to the other person after a request or trade is accepted.</small></label>
    <fieldset>
      <legend>Email notifications</legend>
      <label class="check"><input type="checkbox" name="notify_email" <%= user.notify_email === false ? '' : 'checked' %>> <span>Email me at <%= user.email %> when someone requests my dresses, makes a trade offer, or answers my requests.</span></label>
      <small class="muted">Uncheck to stop emails. You can change this anytime here.</small>
    </fieldset>
    <button class="btn">Save</button>
    <p class="links"><a href="/users/<%= user.id %>">See my public profile and reviews</a><% if (isAdmin) { %> · <a href="/admin">Site activity (admin)</a> · <a href="/admin/reports">Reports (admin)</a><% } %></p>
  </form>
</section>
<%- include('partials/footer') %>
