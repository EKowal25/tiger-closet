<%- include('partials/header') %>
<%
  const termsText = r => [
    r.offer_free ? 'free (they know each other)' : null,
    r.offer_fee ? `$${r.fee_amount} rental fee` : null,
    r.offer_deposit ? `$${r.deposit_amount} refundable deposit` : null,
    r.offer_dryclean ? 'will dry clean before returning' : null,
    r.offer_swap ? `swap for "${r.swap_title || 'a dress'}"` : null,
  ].filter(Boolean).join(' + ').replace(/^./, c => c.toUpperCase());
  const contact = (email, phone, venmo) => `${email}${phone ? ' · ' + phone : ''}${venmo ? ' · Venmo @' + venmo : ''}`;
  const payText = (r) => [r.offer_fee ? 'the $' + r.fee_amount + ' rental fee' : null, r.offer_deposit ? 'the $' + r.deposit_amount + ' deposit' : null].filter(Boolean).join(' and ');
  const statusLabel = (s) => ({ countered: 'counter offer', completed: 'traded' })[s] || s;
%>
<% const dealLinks = (kind, x) => {
     const done = kind === 'request' ? ['accepted', 'returned'] : ['completed'];
     const open = kind === 'request' ? ['accepted', 'returned'] : ['accepted', 'completed'];
     if (done.includes(x.status)) { %><a class="btn ghost sm" href="/review/<%= kind %>/<%= x.id %>"><%= reviewed[kind].includes(x.id) ? 'Edit my review' : '★ Leave a review' %></a><% }
     if (open.includes(x.status)) { %><a class="btn ghost sm danger" href="/report/<%= kind %>/<%= x.id %>">Report a problem</a><% }
   }; %>
<h1>My closet</h1>

<section id="received">
  <h2>Requests for my dresses</h2>
  <% if (!received.length) { %><p class="muted">No requests yet.</p><% } %>
  <% received.forEach(r => { %>
    <div class="req card">
      <div>
        <a href="/users/<%= r.borrower_id %>"><strong><%= r.borrower_name %></strong></a><%= r.borrower_year ? " '" + String(r.borrower_year).slice(-2) : '' %> wants <a href="/dresses/<%= r.dress_id %>"><%= r.dress_title %></a>
        <span class="status <%= r.status %>"><%= statusLabel(r.status) %></span>
        <p class="muted"><%= r.event_name ? r.event_name + ' · ' : '' %><%= r.pickup_date %> → <%= r.return_date %> · <strong><%= termsText(r) %></strong></p>
        <% if (r.message) { %><p class="msg">“<%= r.message %>”</p><% } %>
        <% if (r.status === 'countered' && r.counter) { %>
          <div class="counter-box"><strong>Your counter offer:</strong> <%= r.counter.pickup_date %> → <%= r.counter.return_date %> · <%= termsText(r.counter) %>
            <% if (r.counter.message) { %><p class="msg">“<%= r.counter.message %>”</p><% } %>
            <p class="muted">Waiting for <%= r.borrower_name %> to accept or decline.</p></div>
        <% } %>
        <% if (r.status === 'accepted') { %><p class="contact">Contact: <%= contact(r.borrower_email, r.borrower_phone, r.borrower_venmo) %></p><% if (r.offer_deposit || r.offer_fee) { %><p class="paynote">💸 Collect <%= payText(r) %> by Zelle or Venmo before handing over the dress.<%= r.offer_deposit ? ' Send the deposit back when the dress is returned in the same condition.' : '' %></p><% } } %>
      </div>
      <div class="actions">
        <% const act = (a, label, cls) => { %>
          <form method="post" action="/requests/<%= r.id %>/<%= a %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= cls %>"><%= label %></button></form>
        <% } %>
        <% if (r.status === 'pending') { act('accept', 'Accept', ''); %><a class="btn ghost" href="/requests/<%= r.id %>/counter">Counter</a><% act('decline', 'Decline', 'ghost'); } %>
        <% if (r.status === 'countered') { act('withdraw', 'Withdraw counter', 'ghost'); } %>
        <% if (r.status === 'accepted' && !r.offer_swap) { act('returned', 'Mark returned', 'ghost'); } %>
        <% if (r.status === 'accepted' && r.offer_swap) { if (r.owner_got_back) { %><span class="confirmed">✓ You got yours back<%= r.borrower_got_back ? '' : ' · waiting on them' %></span><% } else { act('gotback', 'I got my dress back', 'ghost'); } } %>
        <% dealLinks('request', r) %>
      </div>
    </div>
  <% }) %>
</section>

<section id="sent">
  <h2>My requests</h2>
  <% if (!sent.length) { %><p class="muted">You haven't requested any dresses yet. <a href="/browse">Browse</a></p><% } %>
  <% sent.forEach(r => { %>
    <div class="req card">
      <div>
        <a href="/dresses/<%= r.dress_id %>"><strong><%= r.dress_title %></strong></a> from <a href="/users/<%= r.owner_id %>"><%= r.owner_name %></a>
        <span class="status <%= r.status %>"><%= statusLabel(r.status) %></span>
        <p class="muted"><%= ["pending","countered"].includes(r.status) ? "You offered: " : "" %><%= r.pickup_date %> → <%= r.return_date %> · <%= termsText(r) %></p>
        <% if (r.status === 'countered' && r.counter) { %>
          <div class="counter-box"><strong><%= r.owner_name %>'s counter offer:</strong> <%= r.counter.pickup_date %> → <%= r.counter.return_date %> · <%= termsText(r.counter) %>
            <% if (r.counter.message) { %><p class="msg">“<%= r.counter.message %>”</p><% } %></div>
        <% } %>
        <% if (r.status === 'accepted') { %><p class="contact">Contact: <%= contact(r.owner_email, r.owner_phone, r.owner_venmo) %></p><% if (r.offer_deposit || r.offer_fee) { %><p class="paynote">💸 Send <%= payText(r) %> to <%= r.owner_name %> by Zelle or Venmo<%= r.owner_venmo ? ' (@' + r.owner_venmo + ')' : '' %> to confirm.<%= r.offer_deposit ? ' The deposit comes back to you when you return the dress in the same condition.' : '' %></p><% } } %>
      </div>
      <div class="actions">
        <% if (r.status === 'accepted' && r.offer_swap) { %>
          <% if (r.borrower_got_back) { %><span class="confirmed">✓ You got yours back<%= r.owner_got_back ? '' : ' · waiting on them' %></span>
          <% } else { %><form method="post" action="/requests/<%= r.id %>/gotback"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">I got my dress back</button></form><% } %>
        <% } %>
        <% if (r.status === 'countered') { %>
          <form method="post" action="/requests/<%= r.id %>/accept-counter"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn">Accept counter</button></form>
          <form method="post" action="/requests/<%= r.id %>/decline-counter"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">Decline</button></form>
        <% } %>
        <% dealLinks('request', r) %>
        <% if (['pending','accepted'].includes(r.status)) { %>
          <form method="post" action="/requests/<%= r.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">Cancel</button></form>
        <% } %>
      </div>
    </div>
  <% }) %>
</section>

<%
  const tradeAct = (t, a, label, cls) => { %>
    <form method="post" action="/trades/<%= t.id %>/<%= a %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= cls %>"><%= label %></button></form>
<% };
  const itemList = (t) => { %>
    <ul class="items"><% t.items.forEach(i => { %><li><a href="/dresses/<%= i.id %>"><%= i.title %></a></li><% }) %></ul>
<% };
  const tradeStatus = (t) => statusLabel(t.status);
  const confirmBox = (t, mine, theirs) => {
    if (mine) { %><span class="confirmed">✓ You confirmed<%= theirs ? '' : ' · waiting on them' %></span><% }
    else tradeAct(t, 'confirm', 'We’ve swapped', '');
  };
%>
<section id="trades-received">
  <h2>Trade offers for my dresses</h2>
  <% if (!tradesReceived.length) { %><p class="muted">No trade offers yet. Mark a dress "Up for trade" to get offers.</p><% } %>
  <% tradesReceived.forEach(t => { %>
    <div class="req card">
      <div>
        <a href="/users/<%= t.offerer_id %>"><strong><%= t.offerer_name %></strong></a><%= t.offerer_year ? " '" + String(t.offerer_year).slice(-2) : '' %> offers, for your <a href="/dresses/<%= t.dress_id %>"><%= t.dress_title %></a>:
        <span class="status <%= t.status %>"><%= tradeStatus(t) %></span>
        <% itemList(t) %>
        <% if (t.message) { %><p class="msg">“<%= t.message %>”</p><% } %>
        <% if (t.status === 'countered' && t.counter) { %>
          <div class="counter-box"><strong>Your counter offer:</strong> you asked for
            <ul class="items"><% t.counterItems.forEach(i => { %><li><a href="/dresses/<%= i.id %>"><%= i.title %></a></li><% }) %></ul>
            <% if (t.counter.message) { %><p class="msg">“<%= t.counter.message %>”</p><% } %>
            <p class="muted">Waiting for <%= t.offerer_name %> to accept or decline.</p></div>
        <% } %>
        <% if (t.status === 'accepted') { %><p class="contact">Contact: <%= contact(t.offerer_email, t.offerer_phone, t.offerer_venmo) %></p><p class="muted">Meet up to exchange dresses, then both tap “We’ve swapped”. The dresses then move to each other’s closets.</p><% } %>
      </div>
      <div class="actions">
        <% if (t.status === 'pending') { tradeAct(t, 'accept', 'Accept trade', ''); %><a class="btn ghost" href="/trades/<%= t.id %>/counter">Counter</a><% tradeAct(t, 'decline', 'Decline', 'ghost'); } %>
        <% if (t.status === 'countered') { tradeAct(t, 'withdraw', 'Withdraw counter', 'ghost'); } %>
        <% if (t.status === 'accepted') { confirmBox(t, t.owner_confirmed, t.offerer_confirmed); tradeAct(t, 'cancel', 'Call off', 'ghost'); } %>
        <% dealLinks('trade', t) %>
      </div>
    </div>
  <% }) %>
</section>

<section id="trades-sent">
  <h2>My trade offers</h2>
  <% if (!tradesSent.length) { %><p class="muted">You haven't offered any trades. See what's <a href="/swaps">up for trade</a>.</p><% } %>
  <% tradesSent.forEach(t => { %>
    <div class="req card">
      <div>
        For <a href="/dresses/<%= t.dress_id %>"><strong><%= t.dress_title %></strong></a> from <a href="/users/<%= t.owner_id %>"><%= t.owner_name %></a>, you offered:
        <span class="status <%= t.status %>"><%= tradeStatus(t) %></span>
        <% itemList(t) %>
        <% if (t.status === 'countered' && t.counter) { %>
          <div class="counter-box"><strong><%= t.owner_name %>'s counter offer:</strong> instead, they'd like
            <ul class="items"><% t.counterItems.forEach(i => { %><li><a href="/dresses/<%= i.id %>"><%= i.title %></a></li><% }) %></ul>
            <% if (t.counter.message) { %><p class="msg">“<%= t.counter.message %>”</p><% } %></div>
        <% } %>
        <% if (t.status === 'accepted') { %><p class="contact">Contact: <%= contact(t.owner_email, t.owner_phone, t.owner_venmo) %></p><p class="muted">Meet up to exchange dresses, then both tap “We’ve swapped”.</p><% } %>
      </div>
      <div class="actions">
        <% if (t.status === 'accepted') { confirmBox(t, t.offerer_confirmed, t.owner_confirmed); } %>
        <% if (t.status === 'countered') { tradeAct(t, 'accept-counter', 'Accept counter', ''); tradeAct(t, 'decline-counter', 'Decline', 'ghost'); } %>
        <% if (['pending','accepted'].includes(t.status)) { tradeAct(t, 'cancel', 'Cancel', 'ghost'); } %>
        <% dealLinks('trade', t) %>
      </div>
    </div>
  <% }) %>
</section>

<section>
  <div class="pagehead"><h2>My listings</h2><a class="btn" href="/dresses/new">+ Post a dress</a></div>
  <% if (!listings.length) { %><p class="muted">You haven't posted any dresses yet.</p><% } %>
  <div class="grid">
    <% listings.forEach(d => { %>
      <div class="tile <%= d.active ? '' : 'hidden-listing' %>">
        <a href="/dresses/<%= d.id %>" class="ph"><% if (d.photos[0]) { %><img src="<%= photoUrl(d.photos[0]) %>" alt=""><% } %></a>
        <div class="meta">
          <strong><%= d.title %></strong>
          <span class="muted">Size <%= d.size %><%= d.active ? '' : ' · Hidden' %><%= d.open_to_trade ? ' · Up for trade' : '' %></span>
          <div class="actions">
            <a class="btn ghost sm" href="/dresses/<%= d.id %>/edit">Edit</a>
            <form method="post" action="/dresses/<%= d.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm"><%= d.active ? 'Hide' : 'Show' %></button></form>
            <form method="post" action="/dresses/<%= d.id %>/delete" onsubmit="return confirm('Delete this listing?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm danger">Delete</button></form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
