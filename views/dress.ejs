<%- include('partials/header') %>
<div class="detail">
  <div class="gallery">
    <img id="main" src="/uploads/<%= dress.photos[0] ? dress.photos[0].filename : '' %>" alt="<%= dress.title %>">
    <% if (dress.photos.length > 1) { %>
      <div class="thumbs"><% dress.photos.forEach(p => { %><img src="/uploads/<%= p.filename %>" onclick="document.getElementById('main').src=this.src" alt=""><% }) %></div>
    <% } %>
  </div>
  <div class="info">
    <h1><%= dress.title %></h1>
    <p class="muted">Size <%= dress.size %><%= dress.length ? ' · ' + dress.length : '' %><%= dress.color ? ' · ' + dress.color : '' %><%= dress.designer ? ' · ' + dress.designer : '' %></p>
    <p class="owner">Posted by <strong><%= dress.owner_name %></strong><%= dress.owner_year ? " '" + String(dress.owner_year).slice(-2) : '' %><%= dress.owner_college ? ' · ' + dress.owner_college : '' %></p>
    <% if (dress.description) { %><p class="desc"><%= dress.description %></p><% } %>
    <div class="tags">
      <% if (dress.allow_deposit) { %><i>Deposit<%= dress.min_deposit ? ' (min $' + dress.min_deposit + ')' : '' %></i><% } %>
      <% if (dress.allow_dryclean) { %><i>Dry clean agreement</i><% } %>
      <% if (dress.allow_swap) { %><i>Open to swaps</i><% } %>
    </div>

    <% if (isOwner) { %>
      <div class="card soft">
        <p>This is your listing<%= dress.active ? '' : ' (hidden)' %>. Requests show up in <a href="/closet#received">My closet</a>.</p>
      </div>
    <% } else if (myRequest) { %>
      <div class="card soft">
        <p>You have a <strong><%= myRequest.status %></strong> request for this dress. <a href="/closet#sent">View in My closet</a>.</p>
      </div>
    <% } else { %>
      <form method="post" action="/dresses/<%= dress.id %>/request" class="card stack" id="reqForm">
        <h2>Request to borrow</h2>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Event <input name="event_name" maxlength="80" placeholder="Ivy formal, Princeton Prom…"></label>
        <div class="row">
          <label>Pick up <input type="date" name="pickup_date" required></label>
          <label>Return by <input type="date" name="return_date" required></label>
        </div>
        <fieldset>
          <legend>Your terms</legend>
          <% if (dress.allow_deposit) { %>
            <label class="check"><input type="radio" name="terms" value="deposit" required> Put down a deposit</label>
            <label class="indent" data-for="deposit">Deposit amount ($)
              <input type="number" name="deposit_amount" min="<%= dress.min_deposit %>" max="5000" value="<%= dress.min_deposit || '' %>">
              <small class="muted">Returned to you when the dress comes back in the same condition. Arrange payment (e.g. Venmo) directly.</small>
            </label>
          <% } %>
          <% if (dress.allow_dryclean) { %>
            <label class="check"><input type="radio" name="terms" value="dryclean" required> Agree to dry clean it</label>
            <label class="check indent" data-for="dryclean"><input type="checkbox" name="dryclean_agree"> I agree to have this dress professionally dry cleaned at my expense before returning it.</label>
          <% } %>
          <% if (dress.allow_swap) { %>
            <label class="check"><input type="radio" name="terms" value="swap" required> Swap one of my dresses</label>
            <label class="indent" data-for="swap">
              <% if (myDresses.length) { %>
                <select name="swap_dress_id"><% myDresses.forEach(m => { %><option value="<%= m.id %>"><%= m.title %></option><% }) %></select>
              <% } else { %>
                <small class="muted">You need to <a href="/dresses/new">post a dress</a> first to offer a swap.</small>
              <% } %>
            </label>
          <% } %>
        </fieldset>
        <label>Message <textarea name="message" rows="3" maxlength="1000" placeholder="Hi! I'd love to borrow this for…"></textarea></label>
        <button class="btn big">Send request</button>
      </form>
      <script>
        const f = document.getElementById('reqForm');
        const sync = () => {
          const v = (f.querySelector('input[name=terms]:checked') || {}).value;
          f.querySelectorAll('[data-for]').forEach(el => el.hidden = el.dataset.for !== v);
        };
        f.addEventListener('change', sync); sync();
      </script>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
