<%- include('partials/header') %>
<div class="detail">
  <div class="gallery">
    <img id="main" src="<%= dress.photos[0] ? photoUrl(dress.photos[0]) : '' %>" alt="<%= dress.title %>">
    <% if (dress.photos.length > 1) { %>
      <div class="thumbs"><% dress.photos.forEach(p => { %><img src="<%= photoUrl(p) %>" onclick="document.getElementById('main').src=this.src" alt=""><% }) %></div>
    <% } %>
  </div>
  <div class="info">
    <h1><%= dress.title %></h1>
    <p class="muted">Size <%= dress.size %><%= dress.length ? ' · ' + dress.length : '' %><%= dress.color ? ' · ' + dress.color : '' %><%= dress.designer ? ' · ' + dress.designer : '' %></p>
    <% if (dress.events && dress.events.length) { %>
      <p class="bestfor">Best for: <% dress.events.forEach(ev => { %><a class="eventtag" href="/browse?event=<%= encodeURIComponent(ev) %>"><%= ev %></a><% }) %></p>
    <% } %>
    <% if (dress.condition && CONDITIONS[dress.condition]) { %>
      <p class="valueline"><span>Condition: <strong><%= CONDITIONS[dress.condition].label %></strong></span>
        <% if (dress.retail_price) { %><span><%= dress.retail_estimated ? 'Est. retail' : 'Retail' %>: <strong>$<%= dress.retail_price %></strong></span><% } %></p>
    <% } %>
    <p class="owner">Posted by <a href="/users/<%= dress.owner_id %>"><strong><%= dress.owner_name %></strong></a><% if (ownerRating.n) { %> <span class="rating" title="<%= ownerRating.avg %> out of 5"><%= stars(ownerRating.avg) %> <%= ownerRating.avg %> (<%= ownerRating.n %>)</span><% } %><%= dress.owner_year ? " '" + String(dress.owner_year).slice(-2) : '' %><%= dress.owner_college ? ' · ' + dress.owner_college : '' %></p>
    <% if (dress.description) { %><p class="desc"><%= dress.description %></p><% } %>
    <div class="tags">
      <% if (dress.allow_deposit) { %><i>Deposit<%= dress.min_deposit ? ' (min $' + dress.min_deposit + ')' : '' %></i><% } %>
      <% if (dress.allow_fee) { %><i>Rental fee<%= dress.rental_fee ? ' $' + dress.rental_fee : '' %></i><% } %>
      <% if (dress.allow_dryclean) { %><i>Dry clean agreement</i><% } %>
      <% if (dress.allow_free) { %><i class="free">Free for friends</i><% } %>
      <% if (dress.allow_swap) { %><i>Temporary swap</i><% } %>
      <% if (dress.open_to_trade) { %><i class="trade">Up for trade</i><% } %>
    </div>

    <% const canBorrow = dress.allow_deposit || dress.allow_dryclean || dress.allow_swap || dress.allow_free || dress.allow_fee; /* trade-only dresses skip the borrow form */ %>
    <% if (isOwner) { %>
      <div class="card soft">
        <p>This is your listing<%= dress.active ? '' : ' (hidden)' %>. Requests show up in <a href="/closet#received">My closet</a>.</p>
        <% if (tradeOffers) { %><p><strong><%= tradeOffers %> trade offer<%= tradeOffers > 1 ? 's' : '' %></strong> waiting. <a href="/closet#trades-received">Review</a></p><% } %>
        <a class="btn ghost sm" href="/dresses/<%= dress.id %>/edit">Edit listing</a>
      </div>
    <% } else { %>

      <% if (dress.open_to_trade) { %>
        <section id="trade">
        <% if (myTrade) { %>
          <div class="card soft">
            <p>You have a <strong><%= myTrade.status === 'countered' ? 'counter offer waiting on your' : myTrade.status %></strong> trade offer for this dress. <a href="/closet#trades-sent">View in My closet</a>.</p>
          </div>
        <% } else { %>
          <form method="post" action="/dresses/<%= dress.id %>/trade" class="card stack trade-card">
            <h2>Trade for it</h2>
            <p class="muted">Offer one or more of your dresses. If the owner accepts, you meet up and swap, and each of you keeps the other's dress.</p>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (myDresses.length) { %>
              <fieldset>
                <legend>Dresses you'll give</legend>
                <% myDresses.forEach(m => { %>
                  <label class="check"><input type="checkbox" name="offer_ids" value="<%= m.id %>"> <%= m.title %></label>
                <% }) %>
              </fieldset>
              <label>Message <textarea name="message" rows="2" maxlength="1000" placeholder="I love this dress! Would you trade for my…"></textarea></label>
              <button class="btn big">Send trade offer</button>
            <% } else { %>
              <p><a class="btn" href="/dresses/new">Post a dress</a> first so you have something to offer.</p>
            <% } %>
          </form>
        <% } %>
        </section>
      <% } %>

      <% if (!canBorrow) { %>
      <% } else if (myRequest) { %>
        <div class="card soft">
          <p>You have a <strong><%= myRequest.status === 'countered' ? 'counter offer waiting on your' : myRequest.status %></strong> request for this dress. <a href="/closet#sent">View in My closet</a>.</p>
        </div>
      <% } else { %>
        <form method="post" action="/dresses/<%= dress.id %>/request" class="card stack" id="reqForm">
          <h2 id="borrowTitle">Borrow it</h2>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Event <input name="event_name" maxlength="80" placeholder="Ivy formal, Princeton Prom…"></label>
          <div class="row">
            <label>Pick up <input type="date" name="pickup_date" required></label>
            <label>Return by <input type="date" name="return_date" required></label>
          </div>
          <fieldset>
            <legend>Your terms <small class="muted">(pick one or more)</small></legend>
            <% const unlisted = '<small class="muted"> · owner didn\u2019t list this, but can still accept</small>'; %>
            <label class="check"><input type="checkbox" name="offer_deposit"> <span>Put down a deposit<%- dress.allow_deposit ? '' : unlisted %></span></label>
            <label class="indent" data-for="offer_deposit">Deposit amount ($)
              <input type="number" name="deposit_amount" min="<%= dress.min_deposit %>" max="5000" value="<%= dress.min_deposit || '' %>">
              <small class="muted">Returned to you when the dress comes back in the same condition. You send it to the owner by Zelle or Venmo once they accept.</small>
            </label>
            <label class="check"><input type="checkbox" name="offer_fee"> <span>Pay a rental fee <small class="muted">(not returned)</small><%- dress.allow_fee ? '' : unlisted %></span></label>
            <label class="indent" data-for="offer_fee">Rental fee ($)
              <input type="number" name="fee_amount" min="<%= dress.allow_fee ? dress.rental_fee : 1 %>" max="5000" value="<%= dress.allow_fee && dress.rental_fee ? dress.rental_fee : '' %>">
              <small class="muted">The owner keeps this. You pay it by Zelle or Venmo once they accept. You can combine it with a refundable deposit.</small>
            </label>
            <label class="check"><input type="checkbox" name="offer_dryclean"> <span>Agree to dry clean it<%- dress.allow_dryclean ? '' : unlisted %></span></label>
            <label class="check indent" data-for="offer_dryclean"><input type="checkbox" name="dryclean_agree"> I agree to have this dress professionally dry cleaned at my expense before returning it.</label>
            <label class="check"><input type="checkbox" name="offer_free"> <span>Borrow for free <small class="muted">(we know each other)</small><%- dress.allow_free ? '' : unlisted %></span></label>
            <label class="check"><input type="checkbox" name="offer_swap" <%= offer === 'swap' ? 'checked' : '' %>> <span>Swap: lend them one of my dresses for the same dates<%- dress.allow_swap ? '' : unlisted %></span></label>
            <label class="indent" data-for="offer_swap">
              <% if (myDresses.length) { %>
                <select name="swap_dress_id"><% myDresses.forEach(m => { %><option value="<%= m.id %>"><%= m.title %></option><% }) %></select>
                <small class="muted">You each give the other's dress back afterward.</small>
              <% } else { %>
                <small class="muted">You need to <a href="/dresses/new">post a dress</a> first to offer a swap.</small>
              <% } %>
            </label>
          </fieldset>
          <p class="paynote">💸 Deposits and rental fees are paid directly between the two of you by Zelle or Venmo once the request is accepted. Tiger Closet doesn't handle money.</p>
          <label>Message <textarea name="message" rows="3" maxlength="1000" placeholder="Hi! I'd love to borrow this for…"></textarea></label>
          <button class="btn big" id="borrowBtn">Send request</button>
        </form>
        <script>
          const f = document.getElementById('reqForm');
          const on = (n) => f.querySelector(`input[name=${n}]`).checked;
          const sync = () => {
            f.querySelectorAll('[data-for]').forEach(el => el.hidden = !on(el.dataset.for));
            const swapOnly = on('offer_swap') && !on('offer_deposit') && !on('offer_dryclean') && !on('offer_fee') && !on('offer_free');
            document.getElementById('borrowTitle').textContent = swapOnly ? 'Offer a swap' : 'Borrow it';
            document.getElementById('borrowBtn').textContent = swapOnly ? 'Send swap offer' : 'Send request';
          };
          f.addEventListener('change', sync); sync();
          f.addEventListener('submit', (e) => {
            const picked = ['offer_deposit', 'offer_fee', 'offer_dryclean', 'offer_free', 'offer_swap'].some(on);
            if (!picked) { e.preventDefault(); alert('Pick at least one of your terms.'); }
            else if (on('offer_free') && on('offer_fee')) { e.preventDefault(); alert('Pick either "free" or a rental fee, not both.'); }
          });
          if (location.search.includes('offer=swap')) f.scrollIntoView({ behavior: 'smooth' });
        </script>
      <% } %>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
