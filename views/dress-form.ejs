<%- include('partials/header') %>
<%
  const d = dress || { allow_deposit: true, min_deposit: 50, allow_dryclean: true, allow_swap: false, open_to_trade: false, allow_free: false, allow_fee: false, rental_fee: 20 };
  const editing = !!dress;
  const v = (k) => (d[k] == null ? '' : d[k]);
%>
<section class="narrow card">
  <h1><%= editing ? 'Edit listing' : 'Post a dress' %></h1>
  <form method="post" action="<%= editing ? '/dresses/' + d.id + '/edit' : '/dresses' %>" <%- editing ? '' : 'enctype="multipart/form-data"' %> class="stack" id="dressForm">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (!editing) { %>
      <label>Photos (up to 6) <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic" multiple required id="photos"></label>
      <div id="preview" class="preview"></div>
    <% } %>
    <label>Title <input name="title" required maxlength="100" placeholder="Emerald satin slip dress" value="<%= v('title') %>"></label>
    <div class="row">
      <label>Size <select name="size" required><option value="">Choose…</option><% SIZES.forEach(s => { %><option <%= d.size === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
      <label>Length <select name="length"><option value="">—</option><% LENGTHS.forEach(l => { %><option <%= d.length === l ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
    </div>
    <div class="row">
      <label>Color <input name="color" maxlength="40" placeholder="Emerald" value="<%= v('color') %>"></label>
      <label>Designer / brand <input name="designer" maxlength="60" placeholder="Reformation" value="<%= v('designer') %>"></label>
    </div>
    <label>Description <textarea name="description" rows="4" maxlength="2000" placeholder="Fit notes, fabric, any wear, when it's available…"><%= v('description') %></textarea></label>

    <fieldset>
      <legend>Lend it: how can people borrow it?</legend>
      <label class="check"><input type="checkbox" name="allow_deposit" <%= d.allow_deposit ? 'checked' : '' %> id="allowDeposit"> They put down a deposit</label>
      <label class="indent" id="minDepositWrap" <%= d.allow_deposit ? '' : 'hidden' %>>Minimum deposit ($) <input type="number" name="min_deposit" min="0" max="2000" value="<%= d.min_deposit %>"></label>
      <label class="check"><input type="checkbox" name="allow_fee" <%= d.allow_fee ? 'checked' : '' %> id="allowFee"> <span>They pay a rental fee <small class="muted">(kept by you, not returned; can be on top of a deposit)</small></span></label>
      <label class="indent" id="feeWrap" <%= d.allow_fee ? '' : 'hidden' %>>Rental fee ($) <input type="number" name="rental_fee" min="0" max="2000" value="<%= d.rental_fee || 20 %>"></label>
      <label class="check"><input type="checkbox" name="allow_dryclean" <%= d.allow_dryclean ? 'checked' : '' %>> They agree to dry clean it before returning</label>
      <label class="check"><input type="checkbox" name="allow_free" <%= d.allow_free ? 'checked' : '' %>> <span>Free <small class="muted">(e.g. for friends; you decide who when you accept)</small></span></label>
      <label class="check"><input type="checkbox" name="allow_swap" <%= d.allow_swap ? 'checked' : '' %>> <span>Temporary swap: we lend each other a dress, then give them back</span></label>
    </fieldset>
    <fieldset>
      <legend>Trade it</legend>
      <label class="check"><input type="checkbox" name="open_to_trade" <%= d.open_to_trade ? 'checked' : '' %>> <span><strong>Up for trade.</strong> I'd give this dress away for good in exchange for one (or more) of theirs.</span></label>
    </fieldset>
    <p class="flash err" id="formErr" hidden></p>
    <button class="btn big" id="submitBtn"><%= editing ? 'Save changes' : 'Post dress' %></button>
    <% if (editing) { %><a class="links" href="/dresses/<%= d.id %>">Cancel</a><% } %>
  </form>
</section>
<script>
  const form = document.getElementById('dressForm');
  const input = document.getElementById('photos'), preview = document.getElementById('preview');
  const btn = document.getElementById('submitBtn'), errBox = document.getElementById('formErr');
  const dep = document.getElementById('allowDeposit'), wrap = document.getElementById('minDepositWrap');
  dep.addEventListener('change', () => wrap.hidden = !dep.checked);
  const feeBox = document.getElementById('allowFee'), feeWrap = document.getElementById('feeWrap');
  feeBox.addEventListener('change', () => feeWrap.hidden = !feeBox.checked);
  if (input) input.addEventListener('change', () => {
    preview.innerHTML = '';
    [...input.files].slice(0, 6).forEach(f => { const i = new Image(); i.src = URL.createObjectURL(f); preview.appendChild(i); });
  });

  // Shrink photos to at most 1600px (JPEG) so the upload is fast and stays under the server's size limit.
  async function shrink(file) {
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
      const blob = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.82));
      return blob ? new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file;
    } catch { return file; } // e.g. HEIC on browsers that can't decode it
  }

  if (input) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input.files.length) return;
    errBox.hidden = true; btn.disabled = true; btn.textContent = 'Uploading…';
    try {
      const data = new FormData(form);
      data.delete('photos');
      for (const f of [...input.files].slice(0, 6)) data.append('photos', await shrink(f));
      let total = 0; for (const [, v] of data) total += v.size || 0;
      if (total > 4.2 * 1024 * 1024) throw new Error('Those photos are too large together. Try fewer or smaller photos.');
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { 'X-Requested-With': 'fetch' } });
      if (res.status === 413) throw new Error('Those photos are too large. Try fewer or smaller photos.');
      const out = await res.json().catch(() => ({}));
      if (out.redirect) return void (window.location.href = out.redirect);
      throw new Error(out.error || 'Upload failed. Please try again.');
    } catch (err) {
      errBox.textContent = err.message || 'Upload failed. Please try again.'; errBox.hidden = false;
      btn.disabled = false; btn.textContent = 'Post dress';
    }
  });
</script>
<%- include('partials/footer') %>
