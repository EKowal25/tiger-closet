<%- include('partials/header') %>
<section class="narrow card">
  <h1>Check your email</h1>
  <p>We sent a 6-digit code to <strong><%= user.email %></strong>. Enter it below to confirm it's your school email. Check your spam folder if you don't see it.</p>
  <form method="post" action="/verify" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Code <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required class="code" placeholder="123456"></label>
    <button class="btn big">Verify</button>
  </form>
  <form method="post" action="/verify/resend" class="links">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    Didn't get it? <button class="link accent">Send a new code</button>
  </form>
</section>
<%- include('partials/footer') %>
