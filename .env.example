# Public URL of the site (no trailing slash). CAS and Microsoft redirect back here.
BASE_URL=http://localhost:3000
PORT=3000
# Long random string, required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Princeton CAS server
CAS_URL=https://fed.princeton.edu/cas

# Optional: "Sign in with Microsoft" (Princeton Outlook / Office 365 accounts)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Princeton's Entra tenant ID (recommended), or "organizations"
MS_TENANT=organizations
ALLOWED_DOMAIN=princeton.edu

# Local development only: log in as any NetID without CAS (ignored when NODE_ENV=production)
DEV_LOGIN=false
# NODE_ENV=production
