# Postgres connection string. On Vercel this comes from the Neon integration (DATABASE_URL).
DATABASE_URL=postgres://postgres@localhost:5432/closet

# Public URL of the site (no trailing slash). On Vercel this defaults to your production domain.
BASE_URL=http://localhost:3000
PORT=3000
# Long random string, required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Photo storage: set by Vercel when you connect a Blob store. If unset, photos are saved to ./uploads
BLOB_READ_WRITE_TOKEN=

# Only emails at this domain can sign up
ALLOWED_DOMAIN=princeton.edu

# Email verification codes and password resets, sent with Resend (https://resend.com).
# If these are unset, people can sign up without verifying their email.
RESEND_API_KEY=
EMAIL_FROM=Tiger Closet <noreply@ellakowal.com>
